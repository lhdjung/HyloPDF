{
  "name": "hylopdf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/sync-pdfjs.mjs",
    "predev": "node scripts/sync-pdfjs.mjs",
    "dev": "vite",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "node scripts/sync-pdfjs.mjs && npm run check && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "node tests/run.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "pdfjs-dist": "^5.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.20.1",
    "esbuild": "^0.25.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
