{
  // Everything that runs in Node rather than in the webview: the test harness,
  // the tests themselves, and the scripts that build and measure.
  //
  // These were listed in the app's own tsconfig, which does not set `allowJs`
  // — so `tsc` silently took none of them and the config read as though it
  // had. They are plain JavaScript, so `checkJs` is what actually checks them,
  // and they need Node's globals, which the app must not have.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"]
  },
  "include": ["scripts/**/*.mjs", "vite.config.js"]
}
